   "data": {
    "title": "1 · Rest",
    "content": "<p>You wrote a draft. That is a big deal. Take at least a week away from the manuscript. Sleep, walk, read something else.</p>",
    "attachments": [],
    "shape": "rounded",
    "color": "#CBD5E1",
    "backgroundColor": "#CBD5E1",
    "textColor": "#1E293B",
