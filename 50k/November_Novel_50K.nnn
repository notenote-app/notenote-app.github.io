   "data": {
    "title": "Premise",
    "content": "<p>The seed of the book: pitch, genre, wild questions and stakes.</p><ul><li>[[One-line pitch]]</li><li>[[Genre & tone]]</li><li>[[What if…?]]</li><li>[[Stakes]]</li></ul>",
    "attachments": [],
